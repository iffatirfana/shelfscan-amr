__pycache__/
*.pyc
/dataset/
/runs/
/overlay/
/logs/
*.pt
!models/*.pt
webots/worlds/.*.wbproj
/dataset_v2/
!models_v2/*.pt

# label-MVP build artefacts: regenerated deterministically from the seed
webots/worlds/codes/
webots/worlds/warehouse_qr.wbt
webots/worlds/warehouse_bc.wbt
webots/worlds/layout_qr.json
webots/worlds/layout_bc.json

# v3 (4-class, QR world) frames, previews and weights. The dataset is
# regenerated from its seeds by experiments/run_batch.py capture --classes v3,
# and data.yaml is written by train/train_yolo.py (it holds an absolute path).
/datasets_v3/
/models_v3/

# HUD demo screenshots: regenerated by a HUD=1 run with HUD_SHOTS set
/docs/hud_shots/
/datasets_v4/
/models_v4/

# Per-run generated worlds: run_batch.py writes one _layout_<tag>.json and
# _run_<tag>.wbt per seed and normally removes them, but an interrupted or
# killed run (a HUD recording, a debug seed) leaves them behind. They are
# regenerated deterministically by webots/tools/make_world.py from the seed.
webots/worlds/_layout_*.json
webots/worlds/_run_*.wbt
